#!/usr/bin/env bash

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Turn Node deprecations and rejected promises into hard failures. ESLint and
# pytest have their own warning-as-error flags below.
NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--throw-deprecation --unhandled-rejections=strict"
export NODE_OPTIONS

overall_status=0
output_dir=.test-results/pre-push
mkdir -p "$output_dir"

declare -a result_names=()
declare -a result_statuses=()
declare -a result_logs=()

record_result() {
  result_names+=("$1")
  result_statuses+=("$2")
  result_logs+=("$3")
}

run_gate() {
  local result_name=$1
  local label=$2
  local output_file=$3
  local reject_warnings=$4
  local display_command=$5
  local command_status

  shift 5
  printf '$ %s\n\n' "$display_command" >"$output_file"

  printf '\n==> %s\n' "$label"
  set +e
  "$@" 2>&1 | tee -a "$output_file"
  command_status=${PIPESTATUS[0]}
  set -e

  if ((command_status == 0)) &&
    [[ $reject_warnings == true ]] &&
    LC_ALL=C grep -Eq 'Warning:|warning:|^\(!\)' "$output_file"; then
    printf '\n%s emitted a warning; push rejected.\n' "$label" |
      tee -a "$output_file" >&2
    command_status=1
  fi

  if ((command_status == 0)); then
    record_result "$result_name" "succeeded" "$output_file"
  else
    record_result "$result_name" "FAILED" "$output_file"
    overall_status=1
  fi
}

run_gate \
  "Frontend lint" \
  "Frontend lint (warnings are errors)" \
  "$output_dir/frontend-lint.out" \
  false \
  "npm run lint -- --max-warnings=0" \
  npm run lint -- --max-warnings=0

run_gate \
  "Frontend build" \
  "Frontend typecheck and production build" \
  "$output_dir/frontend-build.out" \
  true \
  "npm run build" \
  npm run build

run_gate \
  "Frontend tests" \
  "Frontend unit and component tests" \
  "$output_dir/frontend-tests.out" \
  true \
  "npm run test:run" \
  npm run test:run

run_gate \
  "Frontend end-to-end tests" \
  "Frontend end-to-end tests (screenshot gallery excluded)" \
  "$output_dir/frontend-e2e-tests.out" \
  true \
  "npm run test:e2e:run" \
  npm run test:e2e:run

if [ ! -x backend/.venv/bin/python ]; then
  backend_log="$output_dir/backend-tests.out"
  printf '$ %s\n\n' \
    "backend/.venv/bin/python -W error -m pytest -c backend/pytest.ini backend" \
    >"$backend_log"
  {
    printf '\nBackend virtualenv is missing: backend/.venv/bin/python\n'
    printf 'Create it and install backend/requirements-dev.txt before pushing.\n'
  } | tee -a "$backend_log" >&2
  record_result "Backend tests" "FAILED" "$backend_log"
  overall_status=1
else
  run_gate \
    "Backend tests" \
    "Backend tests (warnings are errors)" \
    "$output_dir/backend-tests.out" \
    false \
    "backend/.venv/bin/python -W error -m pytest -c backend/pytest.ini backend" \
    backend/.venv/bin/python -W error -m pytest -c backend/pytest.ini backend
fi

printf '\nTest Results\n------------\n'
for index in "${!result_names[@]}"; do
  printf '%s %s: %s\n' \
    "${result_names[$index]}" \
    "${result_statuses[$index]}" \
    "${result_logs[$index]}"
done

if ((overall_status != 0)); then
  printf '\nOne or more pre-push checks failed.\n' >&2
  exit "$overall_status"
fi

printf '\nAll pre-push checks passed.\n'
