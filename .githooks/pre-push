#!/usr/bin/env bash

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Turn Node deprecations and rejected promises into hard failures. ESLint and
# pytest have their own warning-as-error flags below.
NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--throw-deprecation --unhandled-rejections=strict"
export NODE_OPTIONS

overall_status=0
output_dir=.test-results/pre-push
mkdir -p "$output_dir"

# A gate with reject_warnings=true fails when its output has a line matching
# warning_pattern.
# React 19 prints its test warnings with no "Warning:" prefix, so the act()
# ones need their own patterns to be caught at all.
warning_pattern='Warning:|warning:|^\(!\)|not wrapped in act\(|not configured to support act\('

declare -a result_names=()
declare -a result_statuses=()
declare -a result_logs=()

record_result() {
  result_names+=("$1")
  result_statuses+=("$2")
  result_logs+=("$3")
}

run_gate() {
  local result_name=$1
  local label=$2
  local output_file=$3
  local reject_warnings=$4
  local command_status

  shift 4
  {
    printf '$'
    printf ' %q' "$@"
    printf '\n\n'
  } >"$output_file"

  printf '\n==> %s\n' "$label"
  set +e
  "$@" 2>&1 | tee -a "$output_file"
  command_status=${PIPESTATUS[0]}
  set -e

  if ((command_status == 0)) && [[ $reject_warnings == true ]]; then
    local offenders
    offenders=$(
      LC_ALL=C grep -E "$warning_pattern" "$output_file" |
        sort -u || true
    )
    if [[ -n $offenders ]]; then
      {
        printf '\n%s emitted a warning; push rejected. Offending lines:\n' "$label"
        printf '%s\n' "$offenders" | head -n 20
      } | tee -a "$output_file" >&2
      command_status=1
    fi
  fi

  if ((command_status == 0)); then
    record_result "$result_name" "succeeded" "$output_file"
  else
    record_result "$result_name" "FAILED" "$output_file"
    overall_status=1
  fi
}

run_gate \
  "Frontend lint" \
  "Frontend lint (warnings are errors)" \
  "$output_dir/frontend-lint.out" \
  false \
  npm run lint -- --max-warnings=0

run_gate \
  "Frontend build" \
  "Frontend typecheck and production build" \
  "$output_dir/frontend-build.out" \
  true \
  npm run build

# The repository-owned pre-refactor baseline deliberately stays in the gate
# through the CSS import and lazy-route cutovers. Those slices must adapt the
# candidate assembly under test; removing this check would hide load-order loss.
run_gate \
  "CSS cascade parity" \
  "CSS computed-cascade parity against the frozen owner-migration baseline" \
  "$output_dir/css-cascade-parity.out" \
  true \
  npm run css:check-cascade

run_gate \
  "Frontend tests" \
  "Frontend unit and component tests" \
  "$output_dir/frontend-tests.out" \
  true \
  env NODE_OPTIONS="$NODE_OPTIONS --disable-warning=ExperimentalWarning" npm run test:run -- --no-color

# Node-side tooling under scripts/. Separate from the gate above because it runs
# in a node environment against real files and sockets, which the jsdom app
# config cannot provide (see vitest.scripts.config.ts). It covers the e2e run-slot
# allocator, whose failure mode is this gate's own e2e stage colliding with a
# concurrent run (g-e2e-port-collide).
run_gate \
  "Script tests" \
  "Node tooling tests (scripts/)" \
  "$output_dir/script-tests.out" \
  true \
  env NODE_OPTIONS="$NODE_OPTIONS --disable-warning=ExperimentalWarning" npm run test:scripts:run -- --no-color

# Playwright's own config loader calls the deprecated module.register()
# (DEP0205, node_modules/playwright/lib/common/esmLoaderHost.js) on Node >=26,
# so --throw-deprecation crashes the run before any test starts. Drop it for
# this gate only and suppress that specific warning. Any other deprecation,
# including one from our own e2e code, still fails the gate.
run_gate \
  "Frontend end-to-end tests" \
  "Frontend end-to-end tests (screenshot gallery excluded)" \
  "$output_dir/frontend-e2e-tests.out" \
  true \
  env NODE_OPTIONS="${NODE_OPTIONS//--throw-deprecation/} --disable-warning=DEP0205" npm run test:e2e:run

if [ -x backend/.venv/bin/python ]; then
  run_gate \
    "Backend lint" \
    "Backend Ruff lint" \
    "$output_dir/backend-lint.out" \
    false \
    backend/.venv/bin/python -m ruff check --config backend/ruff.toml --no-cache backend
else
  backend_lint_log="$output_dir/backend-lint.out"
  printf '$ %s\n\n' \
    "backend/.venv/bin/python -m ruff check --config backend/ruff.toml --no-cache backend" \
    >"$backend_lint_log"
  {
    printf '\nBackend virtualenv is missing: backend/.venv/bin/python\n'
    printf 'Create it and install backend/requirements-dev.txt before pushing.\n'
  } | tee -a "$backend_lint_log" >&2
  record_result "Backend lint" "FAILED" "$backend_lint_log"
  overall_status=1
fi

if [ ! -x backend/.venv/bin/python ]; then
  backend_log="$output_dir/backend-tests.out"
  printf '$ %s\n\n' \
    "backend/.venv/bin/python -W error -m pytest -c backend/pytest.ini backend" \
    >"$backend_log"
  {
    printf '\nBackend virtualenv is missing: backend/.venv/bin/python\n'
    printf 'Create it and install backend/requirements-dev.txt before pushing.\n'
  } | tee -a "$backend_log" >&2
  record_result "Backend tests" "FAILED" "$backend_log"
  overall_status=1
else
  # `-m "not release_seal"`: the production-shape PostgreSQL delta-lane benchmark takes
  # minutes and requires its deliberately provisioned disposable database. It is a release
  # validation, not an ordinary pre-push test; the summary below names what did not run.
  run_gate \
    "Backend tests" \
    "Backend tests (warnings are errors; release-only benchmark deselected)" \
    "$output_dir/backend-tests.out" \
    false \
    backend/.venv/bin/python -W error -m pytest -c backend/pytest.ini backend \
    -m "not release_seal"
fi

release_seal_command='backend/.venv/bin/python -m pytest -c backend/pytest.ini backend -m release_seal'

printf '\nTest Results\n------------\n'
for index in "${!result_names[@]}"; do
  printf '%s %s: %s\n' \
    "${result_names[$index]}" \
    "${result_statuses[$index]}" \
    "${result_logs[$index]}"
done

# Say what was NOT run, every time. A deselection nobody is reminded of is a deselection that
# quietly becomes "we deleted those tests".
printf '\nNot run by this gate: @release_seal (the production-shape delta-lane benchmark).\n'
printf 'Run it when validating that release-only benchmark:\n  %s\n' "$release_seal_command"

if ((overall_status != 0)); then
  printf '\nOne or more pre-push checks failed.\n' >&2
  exit "$overall_status"
fi

printf '\nAll pre-push checks passed.\n'
