.env
backend/.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.test-results/

# Playwright
playwright-report/
test-results/
blob-report/
e2e/screenshots/output/
backend/.tmp/e2e.sqlite3
backend/.opening_graph_cache/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
/work
/work.md

# Frozen-cohort capture (g-p4ih-capture): the provenance-side exclusive temp pattern, so a
# stale temp from a killed run can never be staged. The committed cohort_provenance.json is
# reviewed (NOT ignored); the private artifact temp and the flock files live OUTSIDE the
# working tree and need no entry.
backend/scripts/fixtures/cohort_provenance.json.tmp-*

# An agent CLI's per-project config. It is a SYMLINK into a home directory outside the repo,
# so committing it puts a path off the release volume into the sealed checkout; the boundary
# launcher refuses a run whose volume carries one (g-release-os-boundary).
.antigravitycli/

# Beads / Dolt files (added by bd init)
.beads/proxieddb/
/tmp/
/backend/.tmp/

# Resumable corpus captures checkpoint beside their final analysis artifact.
# The final JSON/JSONL is reviewed and committed; an in-progress checkpoint is not.
/docs/analysis/.*.checkpoint.json
