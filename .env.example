# Ghost Replay Frontend Environment Variables
# Copy this file to .env for local development

# Backend API URL (defaults to http://localhost:8000 if not set)
VITE_API_URL=http://localhost:8000

# PostHog analytics (frontend). The project token is a public ingestion key
# (it ships in the JS bundle), so it is safe in the client — but .env stays
# gitignored anyway. Analytics is OFF unless the token is set AND not disabled.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
# PostHog host. Defaults to the same-origin reverse proxy "/ingest" (see
# vercel.json rewrites + vite.config.ts proxy) so requests aren't blocked by
# COEP cross-origin isolation. Set an absolute host (e.g. https://eu.i.posthog.com
# or a self-hosted instance) only to bypass the proxy.
VITE_PUBLIC_POSTHOG_HOST=/ingest
# Set to "true" to force analytics off even when a token is present.
VITE_PUBLIC_POSTHOG_DISABLED=

# Featurebase feedback portal (https://ghostchess.featurebase.app).
# The in-app "Feedback" nav button opens this hosted portal in a new tab. We
# link out rather than embed the widget because the app is cross-origin isolated
# (COEP: require-corp, for the Stockfish WASM SharedArrayBuffer), which the
# embeddable widget can't load under — and the widget is a paid feature anyway.
# The portal is free and needs no account. See bead g-7xej.
VITE_PUBLIC_FEATUREBASE_ORG=ghostchess
# Set to "true" to disable the Feedback link (it no-ops) for an environment.
VITE_PUBLIC_FEATUREBASE_DISABLED=
