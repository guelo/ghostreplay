{
  "name": "ghostreplay",
  "private": true,
  "version": "0.1.0",
  "description": "Ghost Replay training client built with React and Vite",
  "type": "module",
  "scripts": {
    "dev": "vite --host ",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "openings:build-index": "node scripts/build-opening-position-index.mjs",
    "openings:ingest": "node scripts/ingest-eco-data.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:scripts:run": "vitest run --config vitest.scripts.config.ts",
    "test:e2e": "node scripts/e2e/run.mjs",
    "test:e2e:run": "node scripts/e2e/run.mjs --config playwright.prepush.config.ts",
    "test:e2e:headed": "node scripts/e2e/run.mjs --headed",
    "test:e2e:ui": "node scripts/e2e/run.mjs --ui",
    "test:e2e:screens": "node scripts/e2e/run.mjs e2e/screenshots",
    "css:check-cascade": "node scripts/css/check-computed-cascade-parity.mjs",
    "gen:engine-identity": "node scripts/gen-browser-engine-identity.mjs",
    "bench:device:build": "BENCH=1 vite build",
    "bench:device:preview": "vite preview --host",
    "bench:device:dev": "vite --host",
    "bench:baseline": "node scripts/bench/run-device-baseline.mjs",
    "bench:corpus": "node scripts/bench/run-node-corpus.mjs",
    "check:visible-tt-determinism": "node scripts/bench/check-visible-tt-determinism.mjs"
  },
  "dependencies": {
    "@posthog/react": "^1.10.2",
    "chess.js": "^1.4.0",
    "posthog-js": "^1.386.8",
    "react": "^19.2.0",
    "react-chessboard": "^5.8.6",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "stockfish": "18.0.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "css-tree": "^3.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.26",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
