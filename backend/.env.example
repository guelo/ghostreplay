# Ghost Replay Backend Environment Variables
# Copy this file to backend/.env for local development.

# --- PostHog analytics (server-side) ---
# Project (ingestion) token from PostHog → Project Settings. This is a public
# ingestion key, not a secret — but the .env file is gitignored regardless.
POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostHog ingestion host (US cloud shown; use https://eu.i.posthog.com for EU).
POSTHOG_HOST=https://us.i.posthog.com

# Set to "true" to disable all analytics (no events emitted). Defaults to off,
# so analytics is enabled whenever a token is present — including local dev.
# The test suite forces this to "true" (see conftest.py).
POSTHOG_DISABLED=false

# Startup-read emergency switch for publishing live opening-score changes after
# the exact Lichess opening boundary. Defaults to false; invalid values fail
# closed. Changing it requires a backend process restart. Existing durable
# markers remain readable when disabled.
OPENING_BOUNDARY_PUBLICATION_ENABLED=false

# Storage for subsequent opening-score rebuilds: legacy or current-b50-v1.
# Defaults to legacy. Invalid values reject startup. Restart after changing;
# this does not trigger a conversion sweep. Enable current only after cutover review.
OPENING_SCORE_STORAGE_FORMAT=legacy
